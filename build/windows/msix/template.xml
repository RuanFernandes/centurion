<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="centurion.exe"
        Arguments=""
        InstallLocation="C:\Program Files\RuanF\Centurion">
    </Installer>
    <PackageInformation
        PackageName="Centurion"
        PackageDisplayName="Centurion"
        PublisherName="CN=RuanF"
        PublisherDisplayName="RuanF"
        Version="0.1.0.0"
        PackageDescription="Local Codex agent orchestration workspace">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.ruanf.centurion"
                Description="Local Codex agent orchestration workspace"
                DisplayName="Centurion"
                ExecutableName="centurion.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Centurion</DisplayName>
            <PublisherDisplayName>RuanF</PublisherDisplayName>
            <Description>Local Codex agent orchestration workspace</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="centurion.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
